---
/**
 * A top five laid out like a manga page: #1 in a tall panel with speed lines
 * bursting behind it, the rest in a two-by-two, each with a caption box.
 * Every picture is cropped to its panel around `focus`.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Favourite } from '../lib/favourites';

interface Props {
  items: readonly Favourite[];
  label: string;
}

const { items, label } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/favourites/*.{jpg,jpeg,png,webp}', { eager: true });
const imageFor = (slug: string) => Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === slug)?.[1].default;
---

<ol class="top5" aria-label={label}>
  {
    items.map((item, i) => {
      const img = imageFor(item.slug);
      return (
        <li class:list={['pick', { 'pick--lead': i === 0 }]}>
          <div class="panel-frame">
            {img ? (
              <Picture
                src={img}
                alt=""
                formats={['avif', 'webp']}
                widths={i === 0 ? [480, 800, 1100] : [400, 640, 960]}
                sizes={i === 0 ? '(min-width: 860px) 440px, 92vw' : '(min-width: 860px) 380px, 46vw'}
                loading="lazy"
                style={item.focus ? `object-position:${item.focus}` : undefined}
              />
            ) : (
              <span class="titlecard" aria-hidden="true">
                {item.title}
              </span>
            )}
          </div>
          <p class="caption">
            <span class="rank" aria-hidden="true">
              #{i + 1}
            </span>
            <span class="name">{item.title}</span>
          </p>
        </li>
      );
    })
  }
</ol>

<style>
  .top5 {
    --ink: #111111;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) repeat(2, minmax(0, 1fr));
    grid-template-rows: auto auto;
    gap: 26px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    isolation: isolate;
  }

  .pick {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pick--lead {
    grid-row: span 2;
  }

  /* Speed lines burst out from behind #1, fading toward its middle and the page. */
  .pick--lead::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -70px -60px -40px;
    pointer-events: none;
    background: repeating-conic-gradient(from 3deg at 50% 45%, var(--ink) 0deg 0.7deg, transparent 0.7deg 4.5deg);
    mask-image: radial-gradient(closest-side at 50% 45%, transparent 62%, #000 78%, transparent 100%);
    opacity: 0.45;
  }

  /* Panels: a hard ink border on white, square corners, like a printed page. */
  .panel-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 4px solid var(--ink);
    background: #ffffff;
  }

  .pick--lead .panel-frame {
    flex: 1 1 0;
    aspect-ratio: auto;
    min-height: 320px;
  }

  .panel-frame :global(picture),
  .titlecard {
    position: absolute;
    inset: 0;
  }

  .panel-frame :global(picture),
  .panel-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .panel-frame :global(img) {
    object-fit: cover;
    transition: transform 450ms ease;
  }

  @media (hover: hover) {
    .pick:hover .panel-frame :global(img) {
      transform: scale(1.05);
    }
  }

  .titlecard {
    display: grid;
    place-items: center;
    padding: 12px;
    background: #ffffff;
    color: var(--ink);
    font: 400 clamp(28px, 3.4vw, 44px) / 1 'Bangers', Impact, sans-serif;
    letter-spacing: 0.03em;
    text-align: center;
  }

  /* Caption boxes overlap the panel's bottom edge, a little crooked, with a hard shadow. */
  .caption {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    display: flex;
    align-items: baseline;
    gap: 8px;
    max-width: calc(100% - 24px);
    margin: -18px 0 0 12px;
    padding: 4px 12px 5px;
    border: 3px solid var(--ink);
    background: #ffffff;
    box-shadow: 4px 4px 0 var(--ink);
    rotate: -1.5deg;
  }

  .pick:nth-child(even) .caption {
    rotate: 1.2deg;
  }

  .rank {
    font: 400 22px/1 'Bangers', Impact, sans-serif;
    letter-spacing: 0.04em;
    color: #d7261e;
  }

  .pick--lead .rank {
    font-size: 30px;
  }

  .name {
    font: 800 14px/1.25 var(--font-body);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .pick--lead .name {
    font-size: 17px;
  }

  /* Tablets and phones: #1 across the top, then two by two. */
  @media (max-width: 860px) {
    .top5 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 14px;
    }

    .pick--lead {
      grid-row: auto;
      grid-column: 1 / -1;
    }

    .pick--lead .panel-frame {
      flex: none;
      aspect-ratio: 4 / 3;
      min-height: 0;
    }

    .pick--lead::before {
      inset: -40px -24px -24px;
    }
  }

  @media (max-width: 520px) {
    .panel-frame {
      border-width: 3px;
    }

    .caption {
      margin: -14px 0 0 6px;
      max-width: calc(100% - 10px);
      padding: 3px 8px 4px;
      border-width: 2px;
      box-shadow: 3px 3px 0 var(--ink);
    }

    .rank {
      font-size: 18px;
    }

    .name {
      font-size: 12px;
    }
  }
</style>
