---
/**
 * A top five, all visible at once: #1 large, the rest in a two-by-two.
 * "poster" frames them like lobby posters on the club wall; "cartridge" like
 * game carts on a shelf. Each picture is cropped to its frame around `focus`.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Favourite } from '../lib/favourites';

interface Props {
  items: readonly Favourite[];
  variant: 'poster' | 'cartridge';
  label: string;
}

const { items, variant, label } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/favourites/*.{jpg,jpeg,png,webp}', { eager: true });
const imageFor = (slug: string) => Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === slug)?.[1].default;
const rank = (i: number) => String(i + 1).padStart(2, '0');
---

<ol class:list={['top5', `top5--${variant}`]} aria-label={label}>
  {
    items.map((item, i) => {
      const img = imageFor(item.slug);
      return (
        <li class:list={['pick', { 'pick--lead': i === 0 }]}>
          <div class="frame">
            {img ? (
              <Picture
                src={img}
                alt=""
                formats={['avif', 'webp']}
                widths={i === 0 ? [480, 800, 1100] : [400, 640, 960]}
                sizes={i === 0 ? '(min-width: 860px) 440px, 92vw' : '(min-width: 860px) 380px, 46vw'}
                loading="lazy"
                style={item.focus ? `object-position:${item.focus}` : undefined}
              />
            ) : (
              <span class="titlecard" aria-hidden="true">
                {item.title}
              </span>
            )}
          </div>
          <p class="caption">
            <span class="rank" aria-hidden="true">
              {rank(i)}
            </span>
            <span class="name">{item.title}</span>
          </p>
        </li>
      );
    })
  }
</ol>

<style>
  .top5 {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) repeat(2, minmax(0, 1fr));
    grid-template-rows: auto auto;
    gap: 22px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pick {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pick--lead {
    grid-row: span 2;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  /* #1 fills the height of two rows, so its frame is tall and its picture crops around the focus. */
  .pick--lead .frame {
    flex: 1 1 0;
    aspect-ratio: auto;
    min-height: 320px;
  }

  /* The picture fills its frame without sizing it, so #1 matches the two rows beside it exactly. */
  .frame :global(picture),
  .titlecard {
    position: absolute;
    inset: var(--inset, 0);
  }

  .frame :global(picture),
  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .frame :global(img) {
    object-fit: cover;
  }

  .titlecard {
    display: grid;
    place-items: center;
    padding: 12px;
    background:
      radial-gradient(circle at 50% 40%, color-mix(in srgb, var(--brass) 22%, transparent), transparent 70%),
      #0b1416;
    color: #f3efe6;
    font: italic 500 clamp(24px, 3vw, 40px) / 1.05 var(--font-display);
    text-align: center;
  }

  .caption {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 10px 0 0;
    padding-inline: 2px;
  }

  .rank {
    font: 400 15px/1 var(--font-label);
    color: var(--brass);
  }

  .name {
    font: 700 17px/1.3 var(--font-body);
    color: var(--text);
  }

  .pick--lead .name {
    font-size: 20px;
  }

  /* Lobby posters: a brass frame, a black mat and a hard pixel shadow. */
  .top5--poster .frame {
    border: 3px solid var(--brass);
    border-radius: 3px;
    background: #0b1416;
    box-shadow:
      inset 0 0 0 5px #0b1416,
      6px 6px 0 var(--shadow);
  }

  .top5--poster .frame {
    --inset: 5px;
  }

  /* Game carts: dark plastic, grip ridges along the top, and the art as the label. */
  .top5--cartridge .frame {
    --inset: 16px 9px 9px;
    border-radius: 10px 10px 5px 5px;
    background: #2b2a33;
    box-shadow:
      inset 0 -4px 0 #1b1a21,
      inset 0 0 0 2px #3b3a45,
      6px 6px 0 var(--shadow);
  }

  .top5--cartridge .frame::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 30%;
    right: 30%;
    height: 6px;
    background: repeating-linear-gradient(90deg, #45444f 0 3px, transparent 3px 7px);
  }

  .top5--cartridge .frame :global(img),
  .top5--cartridge .titlecard {
    border-radius: 4px;
  }

  /* Tablets and phones: #1 across the top, then two by two. */
  @media (max-width: 860px) {
    .top5 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 14px;
    }

    .pick--lead {
      grid-row: auto;
      grid-column: 1 / -1;
    }

    .pick--lead .frame {
      flex: none;
      aspect-ratio: 4 / 3;
      min-height: 0;
    }
  }

  @media (max-width: 520px) {
    .name {
      font-size: 15px;
    }

    .rank {
      font-size: 13px;
    }

    .top5--poster .frame {
      --inset: 3px;
    }

    .top5--cartridge .frame {
      --inset: 12px 6px 6px;
    }

    .top5--cartridge .frame::before {
      top: 3px;
      height: 5px;
    }
  }
</style>
