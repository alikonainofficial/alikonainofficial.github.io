---
import { acts, education, timeInProduction } from '../lib/profile';

const { years } = timeInProduction();
---

<section id="story" class="story wrap" aria-labelledby="story-title" data-dwell="my story">
  <div class="setlist">
    <div class="section-head gel-magenta">
      <h2 id="story-title" class="display">The set list</h2>
      <p>{years}+ years in production, most recent first.</p>
    </div>
    <ol class="sets">
      {
        acts.map((act) => (
          <li class="set">
            <span class="dates">
              {act.start} to {act.end}
            </span>
            <span class="set-body">
              <span class="set-title">
                {act.role}, <span class="company">{act.company}</span>
              </span>
              <span class="set-line">{act.line}</span>
            </span>
          </li>
        ))
      }
    </ol>
    <p class="education">
      Studied at {
        education.map((e, i) => (
          <>
            {i > 0 && ' and '}
            {e.school.split(',')[0]} ({e.degree.replace('Master of Business Administration', 'MBA')})
          </>
        ))
      }.
    </p>
  </div>

</section>

<style>
  .story {
    padding-block: 88px;
  }

  .sets {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .set {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 4px 24px;
    padding-block: 20px;
    border-bottom: 1px solid var(--line);
  }

  .dates {
    color: var(--muted);
    font-size: 16px;
    padding-top: 3px;
  }

  .set-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .set-title {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.25;
  }

  .company {
    color: var(--brass);
  }

  .education {
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 16px;
  }


  @media (max-width: 640px) {
    .set {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
