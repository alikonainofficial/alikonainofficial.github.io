---
/**
 * After hours: three pixel scenes of Ali off the clock. Each rests on its poster
 * frame and plays once, for a few seconds, when the visitor presses start.
 * Under reduced motion there is no start button, only the still.
 */
import { finalState, scenes, type Scene, type SceneLayer } from '../lib/scenes';
import { Raster, seeded } from '../lib/pixel';
import { spritePaths, type Palette } from '../lib/sprite';

const paths = (scene: Scene, grid: string[]) => spritePaths({ width: scene.width, height: scene.height, grid, palette: scene.palette });
const startOf = (l: SceneLayer) => ({ f: 0, show: true, dx: 0, dy: 0, ...l.start });

// The section's own night: pixel stars and a city skyline, drawn with the same pixel pipeline as
// the scenes and tiled as CSS backgrounds, so each pixel stays square at any width.
const svgUrl = (r: Raster, palette: Palette) => {
  const body = spritePaths({ width: r.width, height: r.height, grid: r.grid(), palette })
    .map(({ fill, d }) => `<path fill='${fill}' d='${d}'/>`)
    .join('');
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${r.width} ${r.height}' shape-rendering='crispEdges'>${body}</svg>`;
  return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
};

const rand = seeded(2026);
const stars = new Raster(64, 64);
for (let i = 0; i < 18; i++) {
  const x = Math.floor(rand() * 62) + 1;
  const y = Math.floor(rand() * 62) + 1;
  if (rand() < 0.25) stars.set(x, y, 'b').set(x - 1, y, 'd').set(x + 1, y, 'd').set(x, y - 1, 'd').set(x, y + 1, 'd');
  else stars.set(x, y, rand() < 0.5 ? 'b' : 'd');
}

const skyline = new Raster(120, 40);
for (let x = 0; x < 120; ) {
  const w = Math.min(6 + Math.floor(rand() * 9), 120 - x);
  const h = 10 + Math.floor(rand() * 26);
  skyline.rect(x, 40 - h, w, h, 'k');
  for (let wy = 40 - h + 2; wy < 38; wy += 3) for (let wx = x + 1; wx < x + w - 1; wx += 2) if (rand() < 0.28) skyline.set(wx, wy, rand() < 0.7 ? 'y' : 'p');
  if (rand() < 0.25) skyline.rect(x + Math.floor(w / 2), 40 - h - 4, 1, 4, 'k');
  x += w;
}

const moon = new Raster(12, 12).disc(6, 6, 5.6, 'm').set(4, 4, 'c').set(7, 7, 'c').set(5, 8, 'c').set(8, 3, 'c');

const sky = {
  '--stars': svgUrl(stars, { b: '#ffffff', d: '#9d8cff' }),
  '--skyline': svgUrl(skyline, { k: '#0c0a24', y: '#ffd36b', p: '#ff7ab6' }),
  '--moon': svgUrl(moon, { m: '#fff1c7', c: '#e6d29b' }),
};
const skyStyle = Object.entries(sky)
  .map(([k, v]) => `${k}:${v}`)
  .join(';');
---

<section id="after-hours" class="after-hours" aria-labelledby="after-hours-title" data-dwell="the after-hours reel" style={skyStyle}>
  <div class="moon" aria-hidden="true"></div>
  <div class="wrap night">
  <div class="section-head" data-rise>
    <div>
      <p class="eyebrow">Off the clock</p>
      <h2 id="after-hours-title" class="display">After hours</h2>
    </div>
    <p>What I get up to once the laptop closes. Press start on any of them.</p>
  </div>

  <ul class="reels">
    {
      scenes.map((scene, i) => {
        const end = finalState(scene);
        return (
          <li class="reel panel" data-rise style={`--rise-i:${i}`} data-scene data-duration={scene.duration} data-steps={JSON.stringify(scene.steps)}>
            <div class="screen">
              <svg
                viewBox={`0 0 ${scene.width} ${scene.height}`}
                shape-rendering="crispEdges"
                preserveAspectRatio="xMidYMid slice"
                role="img"
                aria-label={scene.label}
              >
                {scene.layers.map((layer) => {
                  const st = end.layers[layer.name]!;
                  return (
                    <g
                      data-layer={layer.name}
                      data-start={JSON.stringify(startOf(layer))}
                      data-end={JSON.stringify(st)}
                      data-speed={layer.speed}
                      data-wrap={layer.wrap}
                      data-fps={layer.fps}
                      transform={`translate(${st.dx} ${st.dy})`}
                      style={st.show ? undefined : 'display:none'}
                    >
                      {layer.frames.map((grid, i) => {
                        const ps = paths(scene, grid);
                        return (
                          <g data-f={i} style={i === st.f ? undefined : 'display:none'}>
                            {ps.map(({ fill, d }) => (
                              <path fill={fill} d={d} />
                            ))}
                            {layer.wrap && (
                              <g transform={`translate(${layer.wrap} 0)`}>
                                {ps.map(({ fill, d }) => (
                                  <path fill={fill} d={d} />
                                ))}
                              </g>
                            )}
                          </g>
                        );
                      })}
                    </g>
                  );
                })}
              </svg>
              <p class="hud" data-hud hidden aria-live="polite"></p>
            </div>
            <div class="reel-body">
              <h3>{scene.title}</h3>
              <p>{scene.caption}</p>
              <button type="button" class="btn btn--line play" data-play aria-label={`Press start: ${scene.title}`}>
                <span aria-hidden="true">▶</span> <span data-play-label>Press start</span>
              </button>
            </div>
          </li>
        );
      })
    }
  </ul>
  </div>
</section>

<script>
  interface State {
    f: number;
    show: boolean;
    dx: number;
    dy: number;
  }
  interface Step {
    at: number;
    set?: Record<string, Partial<State>>;
    hud?: string;
  }

  let current: { card: HTMLElement; raf: number; finish: () => void } | undefined;

  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  function layers(card: HTMLElement) {
    return [...card.querySelectorAll<SVGGElement>('[data-layer]')];
  }

  function draw(layer: SVGGElement, st: State, offset = 0) {
    layer.style.display = st.show ? '' : 'none';
    layer.setAttribute('transform', `translate(${st.dx - offset} ${st.dy})`);
    layer.querySelectorAll<SVGGElement>(':scope > [data-f]').forEach((g) => {
      g.style.display = Number(g.dataset.f) === st.f ? '' : 'none';
    });
  }

  function setHud(card: HTMLElement, text: string) {
    const hud = card.querySelector<HTMLElement>('[data-hud]')!;
    hud.textContent = text;
    hud.hidden = !text;
  }

  function play(card: HTMLElement) {
    current?.finish();
    const steps = JSON.parse(card.dataset.steps ?? '[]') as Step[];
    const duration = Number(card.dataset.duration);
    const ls = layers(card);
    const state = new Map(ls.map((l) => [l, JSON.parse(l.dataset.start!) as State]));
    const byName = new Map(ls.map((l) => [l.dataset.layer!, l]));
    const button = card.querySelector<HTMLButtonElement>('[data-play]')!;
    const label = card.querySelector<HTMLElement>('[data-play-label]')!;
    let next = 0;
    const t0 = performance.now();

    const finish = () => {
      cancelAnimationFrame(run.raf);
      ls.forEach((l) => draw(l, JSON.parse(l.dataset.end!) as State));
      setHud(card, steps.filter((s) => s.hud !== undefined).at(-1)?.hud ?? '');
      card.classList.remove('is-playing');
      button.disabled = false;
      label.textContent = 'Play again';
      if (current === run) current = undefined;
    };

    const tick = (now: number) => {
      const t = now - t0;
      if (t >= duration) return finish();
      while (next < steps.length && steps[next]!.at <= t) {
        const step = steps[next++]!;
        for (const [name, s] of Object.entries(step.set ?? {})) {
          const l = byName.get(name);
          if (l) Object.assign(state.get(l)!, s);
        }
        if (step.hud !== undefined) setHud(card, step.hud);
      }
      for (const l of ls) {
        const st = { ...state.get(l)! };
        const fps = Number(l.dataset.fps || 0);
        const frames = l.querySelectorAll(':scope > [data-f]').length;
        if (fps && frames > 1) st.f = Math.floor((t * fps) / 1000) % frames;
        const speed = Number(l.dataset.speed || 0);
        const wrap = Number(l.dataset.wrap || 0);
        draw(l, st, speed && wrap ? Math.round((speed * t) / 1000) % wrap : 0);
      }
      run.raf = requestAnimationFrame(tick);
    };

    const run = { card, raf: 0, finish };
    current = run;
    card.classList.add('is-playing');
    button.disabled = true;
    label.textContent = 'Playing';
    run.raf = requestAnimationFrame(tick);
  }

  // Only one scene plays at a time, and a scene scrolled out of view stops on its poster frame.
  const watcher = new IntersectionObserver((entries) => {
    for (const e of entries) if (!e.isIntersecting && current?.card === e.target) current.finish();
  });

  document.addEventListener('astro:page-load', () => {
    current = undefined;
    document.querySelectorAll<HTMLElement>('[data-scene]').forEach((card) => {
      watcher.observe(card);
      const button = card.querySelector<HTMLButtonElement>('[data-play]')!;
      button.hidden = reduced();
      button.addEventListener('click', () => play(card));
    });
  });
</script>

<style>
  /* A 16-bit night: banded sky, pixel stars, a moon, and the city asleep along the bottom.
     It stays night in either house light; it is after hours, after all. */
  .after-hours {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #f2eeff;
    background: linear-gradient(
      to bottom,
      #0a0820 0 22%,
      #110d32 22% 42%,
      #1a1245 42% 60%,
      #251855 60% 76%,
      #342064 76% 100%
    );
  }

  .after-hours::before,
  .after-hours::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
  }

  .after-hours::before {
    background: var(--stars) 0 0 / 384px 384px;
    mask-image: linear-gradient(to bottom, #000 40%, transparent 85%);
  }

  .after-hours::after {
    inset: auto 0 0;
    height: 240px;
    background: var(--skyline) 0 100% / 720px 240px repeat-x;
  }

  .moon {
    position: absolute;
    z-index: -1;
    top: 24px;
    right: max(20px, calc(50% - 700px));
    width: 84px;
    height: 84px;
    background: var(--moon) center / contain no-repeat;
    filter: drop-shadow(0 0 24px rgba(255, 241, 199, 0.45));
  }

  .night {
    padding-block: 88px 200px;
  }

  .after-hours .section-head h2 {
    font-family: var(--font-game);
    font-weight: 400;
    color: #ffffff;
    text-shadow: 4px 4px 0 #ff5fa2;
  }

  .after-hours .section-head p,
  .after-hours .eyebrow {
    color: #cbc2f5;
  }

  .after-hours .section-head::before {
    display: none;
  }

  .reels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each scene is a lit window in the night: a deep panel with a hard pixel shadow. */
  .reel {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 3px solid #6b5bd6;
    border-radius: 4px;
    background: rgba(13, 10, 38, 0.9);
    box-shadow: 6px 6px 0 #05040f;
  }

  /* The scene sits in a dark bezel, like the arcade cabinets, with a pixel shadow under it. */
  .screen {
    position: relative;
    margin: 10px 10px 0;
    padding: 4px;
    border-radius: 2px;
    background: #05040f;
  }

  .screen svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    image-rendering: pixelated;
  }

  .hud {
    position: absolute;
    top: 12px;
    left: 50%;
    translate: -50% 0;
    margin: 0;
    padding: 3px 8px;
    background: rgba(0, 0, 0, 0.62);
    color: #ffffff;
    font: 400 14px/1.2 var(--font-game);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .reel-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 16px 20px 20px;
  }

  .reel-body h3 {
    margin: 0;
    font: 400 24px/1.2 var(--font-game);
    color: #ffffff;
  }

  .reel-body p {
    margin: 0 0 8px;
    color: #cbc2f5;
    font-size: 16px;
  }

  /* A chunky pixel button that presses down when you hit it. */
  .play {
    margin-top: auto;
    min-height: 44px;
    padding: 6px 18px;
    border: 3px solid #05040f;
    border-radius: 0;
    background: #ffd36b;
    color: #1a1033;
    box-shadow: 4px 4px 0 #05040f;
    font: 400 15px/1 var(--font-game);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .play:hover {
    background: #ffe08f;
    color: #1a1033;
  }

  .play:active {
    translate: 2px 2px;
    box-shadow: 2px 2px 0 #05040f;
  }

  .play[hidden] {
    display: none;
  }

  .play:disabled {
    cursor: default;
    opacity: 0.7;
  }

  .play:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  @media (max-width: 720px) {
    .moon {
      top: 28px;
      width: 56px;
      height: 56px;
    }

    .night {
      padding-block: 64px 170px;
    }

    .after-hours::after {
      height: 180px;
      background-size: 540px 180px;
    }
  }

  @media (max-width: 960px) {
    .reels {
      grid-template-columns: minmax(0, 1fr);
      max-width: 620px;
      margin-inline: auto;
    }
  }
</style>
