---
/**
 * The rehearsal log: Ali's LeetCode practice, framed as a magician's rehearsal.
 * Built from the daily snapshot, so it ships no script and makes no request.
 */
import NewTabLink from './NewTabLink.astro';
import snapshot from '../data/leetcode.json';
import { hardShare, practice, shortDate, type Snapshot } from '../lib/leetcode';
import { seeded } from '../lib/pixel';
import { grain, styleVars } from '../lib/textures';

const data = snapshot as Snapshot;
const updated = new Date(data.fetchedAt);
const p = practice(data.calendar, updated);
const { solved } = data;
const profile = `https://leetcode.com/u/${data.username}/`;
const levels = [
  { key: 'easy', label: 'Easy', n: solved.easy },
  { key: 'medium', label: 'Medium', n: solved.medium },
  { key: 'hard', label: 'Hard', n: solved.hard },
] as const;
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;

// The longest run, chalked up as tally marks: four strokes and a bar through them for each five.
const rand = seeded(p.longestRun * 7 + 1);
const jitter = (n: number) => (rand() - 0.5) * n;
const MAX_MARKS = 60;
const marks = Math.min(p.longestRun, MAX_MARKS);
const tally = Array.from({ length: Math.ceil(marks / 5) }, (_, g) => {
  const count = Math.min(5, marks - g * 5);
  const strokes = Array.from({ length: Math.min(count, 4) }, (_, i) => {
    const x = 6 + i * 8 + jitter(2);
    return `M${x.toFixed(1)} ${(4 + jitter(3)).toFixed(1)} L${(x + jitter(3)).toFixed(1)} ${(34 + jitter(3)).toFixed(1)}`;
  });
  if (count === 5) strokes.push(`M${(1 + jitter(2)).toFixed(1)} ${(27 + jitter(3)).toFixed(1)} L${(37 + jitter(2)).toFixed(1)} ${(10 + jitter(3)).toFixed(1)}`);
  return strokes.join(' ');
});

const board = styleVars({
  '--dust': grain({ frequency: 0.95, octaves: 1, tone: 'light', amount: 0.05, size: 180, seed: 8 }),
});
---

<section id="rehearsal" class="rehearsal" aria-labelledby="rehearsal-title" data-dwell="the rehearsal log" style={board}>
  <svg class="defs" aria-hidden="true" width="0" height="0">
    <filter id="chalk" x="-10%" y="-10%" width="120%" height="120%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="3" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="2.4" />
    </filter>
  </svg>
  <div class="wrap board">
  <div class="section-head gel-amber" data-rise>
    <div>
      <p class="eyebrow">Backstage</p>
      <h2 id="rehearsal-title" class="display">The rehearsal log</h2>
    </div>
    <p>A trick only looks easy after the hundredth run-through. This is where I run through algorithms, on LeetCode.</p>
  </div>

  <div class="log" data-rise>
    <div class="tally">
      <p class="big"><span class="num">{solved.all}</span> problems solved</p>
      <p class="share">{hardShare(solved)}% of them Medium or Hard</p>

      <div class="mix" role="img" aria-label={levels.map((l) => `${l.label} ${l.n}`).join(', ')}>
        {levels.map((l) => <span class={`seg seg--${l.key}`} style={`flex-grow:${l.n}`} />)}
      </div>
      <ul class="legend" aria-hidden="true">
        {
          levels.map((l) => (
            <li>
              <span class={`dot seg--${l.key}`} />
              {l.label} <strong>{l.n}</strong>
            </li>
          ))
        }
      </ul>

      <figure class="run">
        <div class="marks" role="img" aria-label={`Tally marks for a ${p.longestRun}-day run`}>
          {
            tally.map((d) => (
              <svg viewBox="0 0 40 38" aria-hidden="true">
                <path d={d} />
              </svg>
            ))
          }
        </div>
        <figcaption>Longest run: {plural(p.longestRun, 'day')} in a row.</figcaption>
      </figure>
    </div>

    <figure class="calendar">
      <figcaption>
        Active on <strong>{p.activeDays}</strong> of the last {p.spanDays} days, since {shortDate(p.since)}.
      </figcaption>
      <div class="cal-scroll">
        <div class="cal" style={`--weeks:${p.weeks.length}`}>
          <div class="months" aria-hidden="true">
            {p.months.map((m) => <span style={`grid-column:${m.week + 1}`}>{m.label}</span>)}
          </div>
          <div class="cells" aria-hidden="true">
            {
              p.weeks.map((week) =>
                week.map((d) =>
                  d ? <span class={`cell l${d.level}`} title={`${plural(d.count, 'problem')} on ${shortDate(d.date)}`} /> : <span class="cell empty" />,
                ),
              )
            }
          </div>
        </div>
      </div>
      <div class="scale" aria-hidden="true">
        Less {[0, 1, 2, 3, 4].map((l) => <span class={`cell l${l}`} />)} More
      </div>
    </figure>


    <p class="foot">
      Updated {shortDate(updated)}, every day. <NewTabLink href={profile}>{data.username} on LeetCode</NewTabLink>
    </p>
  </div>
  </div>
</section>

<style>
  /*
   * The rehearsal room's chalkboard: slate with the ghosts of old workings rubbed into it, and the
   * numbers chalked up in white, yellow, blue and pink. Its own palette in either house light.
   */
  .rehearsal {
    --text: #eceee6;
    --muted: #b8c4bd;
    --brass: #f2dc7a;
    --brass-hi: #f8e9a6;
    --marquee: #f2a0b5;
    --chalk-blue: #a9d4e6;
    --line: rgba(236, 238, 230, 0.28);
    --bg: #1e2724;
    position: relative;
    isolation: isolate;
    color: var(--text);
    color-scheme: dark;
    /* Old workings rubbed out with the duster: wide, faint swirls of chalk. */
    background:
      radial-gradient(ellipse 34% 18% at 22% 30%, rgba(236, 238, 230, 0.07), transparent 70%),
      radial-gradient(ellipse 26% 14% at 78% 22%, rgba(236, 238, 230, 0.06), transparent 70%),
      radial-gradient(ellipse 40% 16% at 60% 78%, rgba(236, 238, 230, 0.06), transparent 70%),
      radial-gradient(ellipse 20% 22% at 10% 85%, rgba(236, 238, 230, 0.05), transparent 70%),
      linear-gradient(172deg, transparent 40%, rgba(236, 238, 230, 0.035) 48%, transparent 56%),
      var(--dust) 0 0 / 180px 180px,
      #1e2724;
  }

  .defs {
    position: absolute;
  }

  .rehearsal .section-head::before {
    display: none;
  }

  /* Chalk lettering: a soft edge on the headline. */
  .rehearsal :global(.section-head h2) {
    text-shadow:
      0 0 1px rgba(236, 238, 230, 0.8),
      0 0 12px rgba(236, 238, 230, 0.12);
  }

  .board {
    padding-block: 96px 136px;
  }

  .log {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    grid-template-areas:
      'tally calendar'
      'foot foot';
    gap: 28px 64px;
  }

  .tally {
    grid-area: tally;
  }

  .calendar {
    grid-area: calendar;
    margin: 0;
    min-width: 0;
  }

  .foot {
    grid-area: foot;
    margin: 0;
    padding-top: 16px;
    border-top: 2px dashed var(--line);
    color: var(--muted);
    font-size: 15px;
  }

  .big {
    margin: 0;
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1.2;
  }

  .num {
    display: block;
    font-size: clamp(56px, 6vw, 72px);
    line-height: 1;
    color: var(--brass);
  }

  .share {
    margin: 6px 0 18px;
    color: var(--muted);
    font-size: 16px;
  }

  /* One bar, split by difficulty: the mix matters more than the total. */
  .mix {
    display: flex;
    gap: 3px;
    height: 14px;
  }

  .seg {
    min-width: 6px;
    border-radius: 3px;
    filter: url(#chalk);
    opacity: 0.92;
  }

  .seg--easy {
    background: var(--chalk-blue);
  }

  .seg--medium {
    background: var(--brass);
  }

  .seg--hard {
    background: var(--marquee);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    color: var(--muted);
  }

  .legend strong {
    color: var(--text);
  }

  .dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 6px;
    border-radius: 2px;
  }

  figcaption {
    margin-bottom: 12px;
    font-size: 16px;
    color: var(--muted);
  }

  figcaption strong {
    color: var(--text);
  }

  /* The calendar: square pixels, a week to a column, Monday on top. The cells grow to fill
     the column while the run is young and shrink as the weeks pile up, down to 9px. */
  .cal-scroll {
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .cal {
    --gap: 3px;
    max-width: calc(var(--weeks) * 30px);
    min-width: calc(var(--weeks) * 12px);
  }

  .months,
  .cells {
    display: grid;
    grid-template-columns: repeat(var(--weeks), minmax(0, 1fr));
    column-gap: var(--gap);
  }

  .months {
    margin-bottom: 4px;
    font: 400 12px/1 var(--font-label);
    color: var(--muted);
  }

  .months span {
    white-space: nowrap;
  }

  .cells {
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    row-gap: var(--gap);
  }

  .cells .cell {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }

  .cell {
    display: inline-block;
    width: 11px;
    height: 11px;
    border-radius: 2px;
  }

  /* Chalked squares: an outline for a quiet day, then heavier yellow chalk for busier ones. */
  .l0 {
    box-shadow: inset 0 0 0 1px rgba(236, 238, 230, 0.16);
  }

  .l1 {
    background: color-mix(in srgb, var(--brass) 30%, transparent);
  }

  .l2 {
    background: color-mix(in srgb, var(--brass) 55%, transparent);
  }

  .l3 {
    background: color-mix(in srgb, var(--brass) 80%, transparent);
  }

  .l4 {
    background: var(--brass-hi);
  }

  /* The tally of the longest run. */
  .run {
    margin: 28px 0 0;
  }

  .marks {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
  }

  .marks svg {
    width: 40px;
    height: 38px;
    overflow: visible;
  }

  .marks path {
    fill: none;
    stroke: var(--text);
    stroke-width: 2.6;
    stroke-linecap: round;
    opacity: 0.9;
    filter: url(#chalk);
  }

  .run figcaption {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 16px;
  }

  .empty {
    background: transparent;
  }

  .scale {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 3px;
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .log {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'tally' 'calendar' 'foot';
    }
  }
</style>
