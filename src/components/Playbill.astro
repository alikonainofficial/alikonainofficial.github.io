---
import { acts, education } from '../lib/profile';
import Avatar from './Avatar.astro';
---

<section id="story" class="story wrap" aria-labelledby="program-title">
  <div class="playbill-frame px-corners">
    <div class="playbill">
      <h2 id="program-title" class="display">Tonight's program</h2>
      <ol class="acts">
        {
          acts.map((act) => (
            <li class="act">
              <span class="numeral display" aria-hidden="true">
                Act {act.numeral}
              </span>
              <span class="act-body">
                <span class="act-title">
                  <span class="visually-hidden">Act {act.numeral}: </span>
                  {act.company}, {act.role.toLowerCase()}
                </span>
                <span class="act-dates">
                  {act.start} to {act.end}
                </span>
                <span class="act-line">{act.line}</span>
              </span>
            </li>
          ))
        }
      </ol>
      <p class="education">
        Trained at {education.map((e, i) => <>{i > 0 && ' and '}{e.school.split(',')[0]} ({e.degree.replace('Master of Business Administration', 'MBA')})</>)}.
      </p>
    </div>
  </div>

  <aside class="offstage" aria-labelledby="offstage-title">
    <Avatar scale={4} label="" class="offstage-avatar" />
    <h2 id="offstage-title" class="display">Off stage</h2>
    <ul>
      <li>280+ anime and 35+ manga. One Piece, Berserk and Code Geass are all tens.</li>
      <li>Pokémon, Halo and God of War, on repeat.</li>
      <li>The gym, every day.</li>
      <li>Cooking for a cat who never says thanks.</li>
      <li>A beginner's interest in mentalism and hypnosis, which explains the opening act. Ask me to read you sometime.</li>
    </ul>
  </aside>
</section>

<style>
  .story {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    padding-block: 40px 100px;
  }

  .playbill-frame {
    flex: 2 1 560px;
    background: var(--playbill);
    padding: 6px;
  }

  .playbill {
    border: 3px solid var(--velvet-light);
    padding: clamp(24px, 4vw, 40px);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .playbill h2 {
    margin: 0;
    text-align: center;
    font-size: clamp(46px, 5vw, 64px);
    color: var(--velvet-light);
  }

  .acts {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .act {
    display: grid;
    grid-template-columns: 108px minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
  }

  .numeral {
    font-size: 32px;
    color: var(--velvet-light);
    white-space: nowrap;
  }

  .act-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .act-title {
    font-size: 20px;
    font-weight: 700;
  }

  .act-dates {
    font-size: 15px;
    color: var(--muted-ink);
  }

  .act-line {
    font-size: 17px;
  }

  .education {
    margin: 0;
    padding-top: 18px;
    border-top: 3px dotted var(--velvet-light);
    font-size: 16px;
    color: var(--muted-ink);
  }

  .offstage {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .offstage h2 {
    margin: 0;
    font-size: 48px;
    color: var(--brass);
  }

  .offstage ul {
    margin: 0;
    padding-left: 22px;
    list-style: square;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .offstage li::marker {
    color: var(--brass);
  }

  @media (max-width: 520px) {
    .act {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
