---
/** The pixel "suits" printed on each playing card. 8×8 grids, drawn as paths. */
interface Props {
  name: 'book' | 'screen' | 'lens' | 'shelf' | 'joystick';
  size?: number;
  color?: string;
}

const PATHS: Record<Props['name'], string> = {
  book: 'M1 1h3v1h-3zM5 1h3v1h-3zM1 2h1v1h-1zM3 2h1v1h-1zM5 2h1v1h-1zM7 2h1v1h-1zM1 3h3v1h-3zM5 3h3v1h-3zM1 4h1v1h-1zM3 4h1v1h-1zM5 4h1v1h-1zM7 4h1v1h-1zM1 5h3v1h-3zM5 5h3v1h-3zM2 6h5v1h-5z',
  screen: 'M0 0h8v1h-8zM0 1h1v1h-1zM7 1h1v1h-1zM0 2h1v1h-1zM2 2h2v1h-2zM5 2h1v1h-1zM7 2h1v1h-1zM0 3h1v1h-1zM2 3h2v1h-2zM5 3h1v1h-1zM7 3h1v1h-1zM0 4h1v1h-1zM7 4h1v1h-1zM0 5h8v1h-8zM3 6h2v1h-2zM2 7h4v1h-4z',
  lens: 'M2 0h3v1h-3zM1 1h1v1h-1zM5 1h1v1h-1zM1 2h1v1h-1zM5 2h1v1h-1zM1 3h1v1h-1zM5 3h1v1h-1zM2 4h3v1h-3zM4 5h2v1h-2zM5 6h2v1h-2zM6 7h2v1h-2z',
  shelf: 'M0 0h1v6h-1zM2 1h1v5h-1zM4 0h1v6h-1zM6 2h1v4h-1zM0 6h8v1h-8zM0 7h1v1h-1zM7 7h1v1h-1z',
  joystick: 'M2 0h2v1h-2zM2 1h2v1h-2zM3 2h1v1h-1zM3 3h1v1h-1zM0 4h7v1h-7zM0 5h1v1h-1zM5 5h2v1h-2zM0 6h7v1h-7z',
};

const { name, size = 32, color = 'currentColor' } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true">
  <path fill={color} d={PATHS[name]} />
</svg>
