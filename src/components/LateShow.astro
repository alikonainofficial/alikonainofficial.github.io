---
/**
 * The late show: the top five anime on a manga page. Paper and ink in either
 * house light, halftone dots in the margins, and a ranking like a weekly magazine's.
 */
import '@fontsource/bangers/latin-400.css';
import TopFive from './TopFive.astro';
import { anime } from '../lib/favourites';
---

<section id="late-show" class="late-show" aria-labelledby="late-show-title" data-dwell="the late show">
  <div class="wrap page">
    <div class="head" data-rise>
      <div>
        <p class="kicker">This week's ranking</p>
        <h2 id="late-show-title">The late show</h2>
      </div>
      <p class="lede">280 anime in, these are the five I'd still stay up for. Ranked, and I'll defend every place.</p>
      <span class="sfx" aria-hidden="true">ドン!</span>
    </div>
    <TopFive items={anime} label="My top five anime, in order" />
  </div>
</section>

<style>
  .late-show {
    --ink: #111111;
    --paper: #f5f1e6;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    border-block: 6px solid var(--ink);
  }

  /* Halftone screentone, thick at the edges of the page and gone in the middle. */
  .late-show::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle, rgba(17, 17, 17, 0.2) 1.3px, transparent 1.8px) 0 0 / 8px 8px;
    mask-image: radial-gradient(ellipse 75% 70% at 50% 50%, transparent 45%, #000 100%);
  }

  .page {
    padding-block: 72px 96px;
  }

  .head {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 12px 40px;
    margin-bottom: 44px;
  }

  .kicker {
    display: inline-block;
    margin: 0 0 10px;
    padding: 4px 10px 3px;
    background: #d7261e;
    color: #ffffff;
    font: 400 18px/1 'Bangers', Impact, sans-serif;
    letter-spacing: 0.08em;
    rotate: -2deg;
  }

  h2 {
    margin: 0;
    font: 400 clamp(56px, 8vw, 96px) / 0.9 'Bangers', Impact, sans-serif;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-shadow: 4px 4px 0 #d7261e;
  }

  .lede {
    margin: 0;
    max-width: 40ch;
    color: #3d3a33;
    font-weight: 500;
  }

  /* A sound effect, lettered in like the page was drawn. Decoration only. */
  .sfx {
    position: absolute;
    right: 0;
    top: -38px;
    font: 900 clamp(34px, 4vw, 52px) / 1 'Bangers', 'Hiragino Sans', 'Yu Gothic', 'Noto Sans JP', sans-serif;
    color: #ffffff;
    -webkit-text-stroke: 2px var(--ink);
    paint-order: stroke fill;
    text-shadow: 3px 3px 0 var(--ink);
    rotate: 8deg;
  }

  .page :global(:focus-visible) {
    outline-color: var(--ink);
  }

  @media (max-width: 720px) {
    .page {
      padding-block: 56px 72px;
    }

    .head {
      margin-bottom: 34px;
    }

    .sfx {
      top: -26px;
    }
  }
</style>
