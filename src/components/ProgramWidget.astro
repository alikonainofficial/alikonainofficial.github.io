---
import { ACTS } from '../lib/acts';
import { person } from '../lib/profile';

// Eight acts, eight playing cards: the program's progress reads like a hand being dealt.
const SUITS = ['♠', '♥', '♦', '♣', '♠', '♥', '♦', '♣'];
---

<div class="program" transition:persist="program" data-program>
  <button class="program-button" type="button" popovertarget="program-panel" data-sfx="flip">
    <span class="program-label" aria-hidden="true">Program</span>
    <span class="pips" aria-hidden="true">
      {ACTS.map((act, i) => <span class:list={['pip', { 'is-red': i % 4 === 1 || i % 4 === 2 }]} data-pip={act.id}>{SUITS[i]}</span>)}
    </span>
    <span class="program-count" aria-hidden="true" data-program-count>0/{ACTS.length}</span>
    <span class="visually-hidden" data-program-name>Tonight's program, 0 of {ACTS.length} acts seen</span>
  </button>

  <p class="act-badge" data-act-badge hidden aria-hidden="true"></p>

  <div id="program-panel" class="program-panel" popover>
    <p class="eyebrow">Tonight's program</p>
    <h2 class="display">Eight acts</h2>
    <p class="program-intro" data-program-left>Hidden around the site. Ticks mean you've seen them.</p>
    <ol class="acts">
      {
        ACTS.map((act, i) => (
          <li data-act={act.id}>
            <span class:list={['tick', { 'is-red': i % 4 === 1 || i % 4 === 2 }]} aria-hidden="true">
              {SUITS[i]}
            </span>
            <span class="act-text">
              <span class="act-name">
                {act.numeral}. {act.href ? <a href={act.href}>{act.name}</a> : act.name}
                <span class="visually-hidden" data-act-status>
                  , not seen yet
                </span>
              </span>
              <span class="act-where">{act.where}</span>
            </span>
          </li>
        ))
      }
    </ol>
    <button class="btn btn--line" type="button" popovertarget="program-panel" popovertargetaction="hide">Close</button>
  </div>

  <dialog class="curtain-call" data-curtain-call aria-labelledby="curtain-call-title">
    <p class="eyebrow">Curtain call · 8/8</p>
    <h2 id="curtain-call-title" class="display">You saw the whole show.</h2>
    <p>All eight acts. Most interviewers stop at three. Thank you for staying to the end.</p>
    <div class="btn-row">
      <a class="btn btn--brass" href={`mailto:${person.email}`}>Email Ali</a>
      <button class="btn btn--line" type="button" data-curtain-close>Take a bow</button>
    </div>
  </dialog>
</div>

<script>
  import { ACTS, readSeen, type ActId } from '../lib/acts';
  import { sfx } from '../lib/audio';
  import { cardBurst } from '../lib/burst';

  const total = ACTS.length;

  function update(fresh?: ActId) {
    const seen = readSeen();
    const left = total - seen.size;
    document.querySelectorAll<HTMLElement>('[data-program-count]').forEach((el) => (el.textContent = `${seen.size}/${total}`));
    document.querySelectorAll<HTMLElement>('[data-program-name]').forEach((el) => (el.textContent = `Tonight's program, ${seen.size} of ${total} acts seen`));
    document.querySelectorAll<HTMLElement>('[data-pip]').forEach((pip) => {
      pip.classList.toggle('is-seen', seen.has(pip.dataset.pip as ActId));
      pip.classList.toggle('is-fresh', pip.dataset.pip === fresh);
    });
    const leftLine = document.querySelector<HTMLElement>('[data-program-left]');
    if (leftLine)
      leftLine.textContent =
        left === 0 ? 'You saw every act. Take a bow.' : left <= 2 ? `${left === 1 ? 'One act' : 'Two acts'} left. You're nearly there.` : `Hidden around the site. ${left} to go.`;
    document.querySelectorAll<HTMLElement>('.program-panel [data-act]').forEach((li) => {
      const done = seen.has(li.dataset.act as ActId);
      li.classList.toggle('is-seen', done);
      const status = li.querySelector('[data-act-status]');
      if (status) status.textContent = done ? ', seen' : ', not seen yet';
    });
  }

  let badgeTimer: number | undefined;
  function badge(id: ActId) {
    const el = document.querySelector<HTMLElement>('[data-act-badge]');
    const act = ACTS.find((a) => a.id === id);
    if (!el || !act) return;
    el.textContent = `Act ${act.numeral} ✓`;
    el.hidden = false;
    el.classList.remove('is-on');
    void el.offsetWidth;
    el.classList.add('is-on');
    window.clearTimeout(badgeTimer);
    badgeTimer = window.setTimeout(() => (el.hidden = true), 2400);
  }

  function curtainCall() {
    try {
      if (localStorage.getItem('curtain-call') === 'seen') return;
      localStorage.setItem('curtain-call', 'seen');
    } catch {
      /* storage blocked: show it anyway */
    }
    const dialog = document.querySelector<HTMLDialogElement>('[data-curtain-call]');
    if (!dialog?.showModal) return;
    document.getElementById('program-panel')?.hidePopover?.();
    dialog.showModal();
    sfx('fanfare');
    const r = dialog.getBoundingClientRect();
    cardBurst({ x: r.left + r.width / 2, y: r.top + 24 });
  }

  document.addEventListener('act:seen', (e) => {
    const id = (e as CustomEvent<ActId>).detail;
    update(id);
    sfx('unlock');
    badge(id);
    // A small bow from the program whenever a new act is ticked off.
    const button = document.querySelector<HTMLElement>('.program-button');
    document.querySelector('[data-program]')?.classList.remove('is-tucked');
    button?.classList.remove('is-bump');
    void button?.offsetWidth;
    button?.classList.add('is-bump');
    if (readSeen().size >= total) window.setTimeout(curtainCall, 1600);
  });
  document.addEventListener('astro:page-load', () => update());

  document.addEventListener('click', (e) => {
    const t = e.target instanceof Element ? e.target : null;
    // Close the program when one of its links is followed.
    if (t?.closest('.program-panel a')) document.getElementById('program-panel')?.hidePopover?.();
    if (t?.closest('[data-curtain-close]')) t.closest('dialog')?.close();
  });

  // Tuck the program away while reading down the page, so it never sits on the text. It comes back on the way up and at the end.
  let lastY = scrollY;
  addEventListener(
    'scroll',
    () => {
      const program = document.querySelector<HTMLElement>('[data-program]');
      if (!program) return;
      const y = scrollY;
      const atEnd = innerHeight + y >= document.documentElement.scrollHeight - 80;
      const panelOpen = document.getElementById('program-panel')?.matches(':popover-open');
      if (Math.abs(y - lastY) < 6) return;
      program.classList.toggle('is-tucked', y > lastY && y > 160 && !atEnd && !panelOpen);
      lastY = y;
    },
    { passive: true },
  );
</script>

<style>
  .program {
    position: fixed;
    right: max(16px, env(safe-area-inset-right, 0px));
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 50;
    transition: transform 260ms ease;
  }

  .program.is-tucked {
    transform: translateY(calc(100% + 32px));
  }

  .program:has(.program-button:focus-visible) {
    transform: none;
  }

  /* The HUD: a pixel label, a hand of eight cards, and the score. */
  .program-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    padding: 8px 14px 8px 16px;
    border: 2px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font: 400 16px/1 var(--font-game);
    box-shadow: 4px 4px 0 var(--shadow);
    cursor: pointer;
  }

  .program-button:hover {
    border-color: var(--brass);
  }

  .program-button.is-bump {
    animation: bump 700ms steps(4, end);
  }

  @keyframes bump {
    30% {
      transform: translateY(-4px);
      border-color: var(--marquee);
    }
  }

  .program-label {
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pips {
    display: inline-flex;
    gap: 3px;
  }

  .pip {
    display: grid;
    place-items: center;
    width: 14px;
    height: 19px;
    border: 1.5px solid var(--line);
    border-radius: 2px;
    color: var(--muted);
    font: 11px/1 var(--font-body);
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .pip.is-seen {
    border-color: var(--card);
    background: var(--card);
    color: var(--card-ink);
  }

  .pip.is-seen.is-red {
    color: var(--card-red);
  }

  .pip.is-fresh {
    border-color: var(--marquee);
    box-shadow: 0 0 0 2px var(--marquee);
    animation: deal 420ms steps(3, end);
  }

  @keyframes deal {
    from {
      transform: translateY(-8px) rotate(-12deg);
    }
  }

  .program-count {
    min-width: 3ch;
    padding: 3px 6px;
    border-radius: 3px;
    background: var(--marquee);
    color: var(--bg);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  /* "Act III ✓": pops up over the program for a moment when an act is ticked off. */
  .act-badge {
    position: absolute;
    right: 0;
    bottom: calc(100% + 10px);
    margin: 0;
    padding: 8px 12px;
    border-radius: 4px;
    background: var(--marquee);
    color: var(--bg);
    font: 400 19px/1 var(--font-game);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 4px 4px 0 var(--shadow);
    pointer-events: none;
  }

  .act-badge[hidden] {
    display: none;
  }

  .program.is-tucked .act-badge {
    visibility: hidden;
  }

  .act-badge.is-on {
    animation: badge 2400ms steps(1, end) both;
  }

  @keyframes badge {
    0% {
      transform: translateY(8px);
      opacity: 0;
    }
    6% {
      transform: translateY(-4px);
      opacity: 1;
    }
    12%,
    85% {
      transform: none;
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 720px) {
    .program-button {
      gap: 8px;
      padding: 6px 10px;
    }

    .program-label {
      display: none;
    }

    .pip {
      width: 12px;
      height: 17px;
      font-size: 10px;
    }
  }

  /* Small phones: a compact chip, one card and the score, so it covers as little of the page as possible. */
  @media (max-width: 480px) {
    .program-button {
      gap: 6px;
      min-width: 44px;
      padding: 6px 8px;
    }

    .pip:not(:first-child) {
      display: none;
    }

    .pip:first-child {
      border-color: var(--card);
      background: var(--card);
      color: var(--card-ink);
    }
  }

  .program-panel {
    width: min(440px, calc(100vw - 32px));
    max-height: min(640px, calc(100vh - 32px));
    overflow: auto;
    margin: auto max(16px, env(safe-area-inset-right, 0px)) calc(76px + env(safe-area-inset-bottom, 0px)) auto;
    padding: 24px 24px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-deep);
    color: var(--text);
    box-shadow: 0 24px 60px var(--shadow);
  }

  .program-panel::backdrop,
  .curtain-call::backdrop {
    background: rgba(4, 16, 19, 0.5);
  }

  .program-panel h2 {
    margin: 4px 0 0;
    font-size: 34px;
  }

  .program-intro {
    margin: 6px 0 16px;
    color: var(--muted);
    font-size: 16px;
  }

  .acts {
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .acts li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }

  /* Each act is a card in the hand: face down until it's been seen. */
  .tick {
    display: grid;
    place-items: center;
    width: 22px;
    height: 30px;
    margin-top: 1px;
    border: 1.5px solid var(--line);
    border-radius: 3px;
    background: var(--card-back);
    color: transparent;
    font-size: 15px;
    line-height: 1;
  }

  .is-seen .tick {
    border-color: var(--card);
    background: var(--card);
    color: var(--card-ink);
  }

  .is-seen .tick.is-red {
    color: var(--card-red);
  }

  .act-text {
    display: flex;
    flex-direction: column;
  }

  .act-name {
    font-weight: 600;
  }

  .act-where {
    color: var(--muted);
    font-size: 15px;
  }

  .curtain-call {
    width: min(520px, calc(100vw - 32px));
    padding: 32px 30px 28px;
    border: 3px solid var(--marquee);
    border-radius: 6px;
    background: var(--bg-deep);
    color: var(--text);
    box-shadow: 8px 8px 0 var(--shadow);
  }

  .curtain-call[open] {
    display: flex;
    flex-direction: column;
    gap: 14px;
    animation: call-in 420ms cubic-bezier(0.2, 1.3, 0.4, 1);
  }

  .curtain-call .eyebrow {
    color: var(--marquee);
  }

  .curtain-call h2 {
    margin: 0;
    font-size: clamp(36px, 6vw, 48px);
  }

  .curtain-call p:not(.eyebrow) {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 20px;
    line-height: 1.45;
  }

  @keyframes call-in {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
  }

  :global(body.plain) .program {
    display: none;
  }
</style>
