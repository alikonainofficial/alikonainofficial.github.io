---
/** A link that leaves the site: opens in a new tab and says so to screen readers. */
import type { HTMLAttributes } from 'astro/types';
import { NEW_TAB_NOTE } from '../lib/new-tab';

type Props = HTMLAttributes<'a'> & { href: string };

const { href, ...rest } = Astro.props;
---

<a href={href} target="_blank" rel="noopener" {...rest}><slot /><span class="visually-hidden">{NEW_TAB_NOTE}</span></a>
