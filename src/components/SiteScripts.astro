---
/** Site-wide behaviour: the band, button sounds, the secret word and the dwell clock. */
---

<script>
  import { sfx, type Sfx } from '../lib/audio';
  import { markSeen } from '../lib/acts';
  import { arrivedAt, saveSession, session, toast, trackDwell } from '../lib/client';

  arrivedAt();

  // Every button and link makes a small sound when sound is on. Elements can ask for a different one.
  document.addEventListener('click', (e) => {
    const el = e.target instanceof Element ? e.target.closest<HTMLElement>('a, button, summary, label') : null;
    if (!el || el.dataset.sfx === 'none') return;
    sfx((el.dataset.sfx as Sfx | undefined) ?? 'click');
  });

  // Act VIII: type "abracadabra" anywhere, or tap the avatar five times.
  const WORD = 'abracadabra';
  let typed = '';
  function revealSecret() {
    if (document.documentElement.classList.contains('is-magic')) return;
    document.documentElement.classList.add('is-magic');
    saveSession('magic', true);
    markSeen('secret');
    toast('Act VIII: you found the secret word. The hat suits me, right?', 'reveal');
  }
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement | null;
    if (t && (t.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName))) return;
    if (e.key.length !== 1) return;
    typed = (typed + e.key.toLowerCase()).slice(-WORD.length);
    if (typed === WORD) revealSecret();
  });
  let taps: number[] = [];
  document.addEventListener('pointerdown', (e) => {
    if (!(e.target instanceof Element) || !e.target.closest('[data-avatar]')) return;
    const now = performance.now();
    taps = [...taps.filter((t) => now - t < 2500), now];
    if (taps.length >= 5) {
      taps = [];
      revealSecret();
    }
  });

  document.addEventListener('astro:page-load', () => {
    if (session('magic', false)) document.documentElement.classList.add('is-magic');
    trackDwell();
  });

  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Play a one-off reaction on every avatar on the page. */
  function react(name: 'is-cheer' | 'is-shrug') {
    if (reduced()) return;
    document.querySelectorAll<SVGElement>('[data-avatar]').forEach((a) => {
      a.classList.remove('is-cheer', 'is-shrug');
      void a.getBoundingClientRect();
      a.classList.add(name);
      window.setTimeout(() => a.classList.remove(name), 800);
    });
  }
  document.addEventListener('act:seen', () => react('is-cheer'));
  document.addEventListener('host:declined', () => react('is-shrug'));

  // The avatar keeps an eye on you: his eyes follow the pointer left and right.
  let pending = false;
  let pointerX = 0;
  document.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    pointerX = e.clientX;
    if (pending) return;
    pending = true;
    requestAnimationFrame(() => {
      pending = false;
      document.querySelectorAll<SVGElement>('[data-avatar]').forEach((a) => {
        const r = a.getBoundingClientRect();
        if (r.bottom < 0 || r.top > innerHeight) return;
        const centre = r.left + r.width / 2;
        const look = pointerX < centre - r.width * 0.6 ? -1 : pointerX > centre + r.width * 0.6 ? 1 : 0;
        a.style.setProperty('--look', String(look));
      });
    });
  });

  // The curtain closes while the next page loads, then opens on it.
  const curtain = () => document.querySelector<HTMLElement>('[data-curtain]');
  let curtainFallback: number | undefined;
  document.addEventListener('astro:before-preparation', (e) => {
    const c = curtain();
    if (!c || reduced() || e.to.pathname === e.from.pathname) return;
    const load = e.loader;
    e.loader = async () => {
      c.classList.add('is-closed');
      sfx('whoosh');
      await Promise.all([load(), new Promise((r) => setTimeout(r, 280))]);
    };
    window.clearTimeout(curtainFallback);
    curtainFallback = window.setTimeout(() => curtain()?.classList.remove('is-closed'), 4000);
  });
  document.addEventListener('astro:page-load', () => {
    window.clearTimeout(curtainFallback);
    requestAnimationFrame(() => requestAnimationFrame(() => curtain()?.classList.remove('is-closed')));
  });
</script>
