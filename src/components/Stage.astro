---
import Avatar from './Avatar.astro';
import ColdRead from './ColdRead.astro';
import HostInvite from './HostInvite.astro';
import { person } from '../lib/profile';
import { TAGLINES } from '../lib/cold-read';
---

<section id="top" class="hero wrap" aria-labelledby="hero-title" data-dwell="the cold read" data-hero>
  <div class="intro">
    <h1 id="hero-title" class="display">{person.name}</h1>
    <p class="tagline" data-tagline>{TAGLINES.fullstack}</p>
  </div>

  <div class="spotlight">
    <div class="stage-light" aria-hidden="true">
      <div class="glow"></div>
      <div class="podium"></div>
      <div class="performer">
        <Avatar scale={8} label="" />
      </div>
    </div>
    <HostInvite />
  </div>

  <div class="reading">
    <ColdRead />
  </div>
</section>

<script>
  // The spotlight follows you: on a desktop, the hero's light drifts toward the pointer.
  let target = { x: 0.7, y: 0.4 };
  let current = { ...target };
  let raf = 0;

  function step() {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero) {
      raf = 0;
      return;
    }
    current.x += (target.x - current.x) * 0.12;
    current.y += (target.y - current.y) * 0.12;
    hero.style.setProperty('--mx', `${(current.x * 100).toFixed(2)}%`);
    hero.style.setProperty('--my', `${(current.y * 100).toFixed(2)}%`);
    raf = Math.abs(target.x - current.x) + Math.abs(target.y - current.y) > 0.001 ? requestAnimationFrame(step) : 0;
  }

  document.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse' || !matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) return;
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero) return;
    const r = hero.getBoundingClientRect();
    if (e.clientY < r.top || e.clientY > r.bottom) return;
    hero.classList.add('is-following');
    target = { x: (e.clientX - r.left) / r.width, y: (e.clientY - r.top) / r.height };
    if (!raf) raf = requestAnimationFrame(step);
  });
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 400px);
    grid-template-areas:
      'intro spot'
      'reading spot';
    align-items: center;
    gap: 22px 56px;
    padding-block: 40px 96px;
  }

  /* The spotlight that follows the pointer. Off for touch and reduced motion; it only appears once the mouse moves.
     The light is its own circle, centred on the pointer and big enough that the gradient fades out before its edges,
     so no box can cut it off. z-index -1 with no isolation on .hero puts it behind the whole page (header and the next
     section included), just above the page background; main clips any sideways spill (see global.css). */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: var(--mx, 70%);
    top: var(--my, 40%);
    width: 840px;
    height: 840px;
    translate: -50% -50%;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(420px circle at center, var(--gel-amber), transparent 70%);
    transition: opacity 600ms ease;
  }

  .hero:global(.is-following)::before {
    opacity: 1;
  }

  .intro {
    grid-area: intro;
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .reading {
    grid-area: reading;
    align-self: start;
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-size: clamp(64px, 9vw, 118px);
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .tagline {
    margin: 0;
    max-width: 36ch;
    font-size: clamp(19px, 2vw, 23px);
    line-height: 1.5;
  }

  .spotlight {
    grid-area: spot;
    position: relative;
    width: 100%;
  }

  .stage-light {
    position: relative;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 48px;
  }

  .glow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 42%, var(--spot), color-mix(in srgb, var(--spot) 22%, transparent) 55%, transparent 70%);
    animation: breathe 6s ease-in-out infinite;
  }

  .podium {
    position: absolute;
    bottom: 36px;
    left: 50%;
    width: 230px;
    height: 38px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: var(--bg-deep);
  }

  .performer {
    position: relative;
  }

  @keyframes breathe {
    50% {
      opacity: 0.75;
    }
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'intro'
        'spot'
        'reading';
    }

    .spotlight {
      max-width: 400px;
      margin-inline: auto;
    }
  }

  /* Phones: name first, then the host beside his question, then the reading. */
  @media (max-width: 720px) {
    .hero {
      gap: 14px;
      padding-block: 12px 56px;
    }

    .intro {
      gap: 12px;
    }

    .spotlight {
      max-width: none;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .stage-light {
      flex: 0 0 112px;
      width: 112px;
      padding-bottom: 14px;
    }

    .stage-light :global(svg) {
      width: 64px;
      height: auto;
    }

    .podium {
      bottom: 8px;
      width: 84px;
      height: 16px;
    }

    /* Without the invite, the host stands alone in the middle. */
    .spotlight:has(:global([data-host-invite][hidden])) {
      justify-content: center;
    }
  }
</style>
