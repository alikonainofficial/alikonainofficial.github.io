---
import { Image } from 'astro:assets';
import NewTabLink from './NewTabLink.astro';
import carracing from '../assets/arcade/carracing.png';
import warrior from '../assets/arcade/warriordungeon.png';
import brick from '../assets/arcade/brickbreaker.png';
import tennis from '../assets/arcade/tennis.png';
import simon from '../assets/arcade/simon.png';
import drumkit from '../assets/arcade/drumkit.png';
import dice from '../assets/arcade/dicegenerator.png';

const games = [
  { title: 'Car Racing', line: 'Race a friend, head to head.', href: 'https://alikonainofficial.github.io/Car_Racing/', img: carracing },
  { title: 'Warrior Legends', line: 'Grab the keys and clear the dungeon.', href: 'https://alikonainofficial.github.io/Warrior_Legends/', img: warrior },
  { title: 'Brick Breaker', line: 'The classic, no frills.', href: 'https://alikonainofficial.github.io/Brick_Breaker/', img: brick },
  { title: 'Tennis', line: 'A quick rally to clear your head.', href: 'https://alikonainofficial.github.io/Tennis_Game/', img: tennis },
  { title: 'Simon', line: 'How long can you hold the pattern?', href: 'https://alikonainofficial.github.io/simon_game/', img: simon },
  { title: 'Drum Kit', line: 'Play the drums with your keyboard.', href: 'https://alikonainofficial.github.io/drumkit/', img: drumkit },
  { title: 'Dice Roller', line: 'Settle an argument the fair way.', href: 'https://alikonainofficial.github.io/randomdicegenerator/', img: dice },
];

// The arcade carpet: neon squiggles, triangles, rings and planets on black, like every arcade
// floor in 1989. One 240px tile, repeated; drawn as SVG so it stays sharp at any size.
const carpet = `<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240' fill='none' stroke-width='4' stroke-linecap='round' stroke-linejoin='round'>
<path d='M18 44q15-20 30 0t30 0t30 0' stroke='#2de2ff'/>
<path d='M150 26l24 40h-48z' stroke='#ff3df0'/>
<circle cx='204' cy='150' r='13' stroke='#ffe14d'/>
<path d='M30 160l14-14 14 14 14-14 14 14' stroke='#9b5cff'/>
<circle cx='116' cy='120' r='9' fill='#ff7a59' stroke='none'/>
<ellipse cx='116' cy='120' rx='17' ry='5' stroke='#ff7a59' stroke-width='3'/>
<path d='M168 208q12-14 24 0t24 0' stroke='#3dff9a'/>
<path d='M60 212l10 10m0-10l-10 10' stroke='#2de2ff' stroke-width='3'/>
<path d='M214 64l8 8m0-8l-8 8' stroke='#ffe14d' stroke-width='3'/>
<circle cx='92' cy='70' r='3' fill='#ff3df0' stroke='none'/>
<circle cx='30' cy='100' r='3' fill='#ffe14d' stroke='none'/>
<circle cx='186' cy='104' r='3' fill='#2de2ff' stroke='none'/>
<circle cx='132' cy='180' r='3' fill='#9b5cff' stroke='none'/>
<path d='M120 232l12-20 12 20' stroke='#2de2ff' stroke-width='3'/>
</svg>`;
const carpetUrl = `url("data:image/svg+xml,${encodeURIComponent(carpet.replace(/\n/g, ''))}")`;
---

<section id="arcade" class="arcade" data-seam="dither" aria-labelledby="arcade-title" data-dwell="the arcade" style={`--carpet:${carpetUrl}`}>
  <div class="wrap inner">
    <div class="section-head gel-cyan" data-rise>
      <div class="arcade-title">
        <p class="arcade-sign" aria-hidden="true">Arcade</p>
        <h2 id="arcade-title" class="display">The back room arcade</h2>
      </div>
      <p>Where it started: small browser games I built in 2020 while learning JavaScript. They still run. Best on a laptop with a keyboard.</p>
    </div>
    <ul class="games">
      {
        games.map((g, i) => (
          <li data-rise style={`--rise-i:${i % 4}`}>
            <NewTabLink class="game" href={g.href}>
              <span class="cabinet">
                <span class="screen">
                  <Image src={g.img} alt="" widths={[320, 480]} sizes="(min-width: 900px) 280px, 45vw" loading="lazy" />
                  <span class="press" aria-hidden="true">Press start</span>
                </span>
              </span>
              <span class="game-title">{g.title}</span>
              <span class="game-line">{g.line}</span>
            </NewTabLink>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* The back room is its own world: lights down, neon carpet, cabinets glowing. Dark in either house light. */
  .arcade {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 50% at 50% 0%, rgba(155, 92, 255, 0.22), transparent 70%),
      #0b0616;
    color: #f4efff;
  }

  .arcade::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--carpet) 0 0 / 240px 240px;
    opacity: 0.26;
  }

  /* Darker toward the walls, so the carpet glows most under the cabinets. */
  .arcade::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: radial-gradient(ellipse 80% 75% at 50% 55%, transparent 40%, rgba(5, 2, 12, 0.85) 100%);
  }

  .inner {
    padding-block: 88px 136px;
  }

  .arcade :global(.section-head h2) {
    color: #ffffff;
  }

  .arcade :global(.section-head p) {
    color: #cfc4ec;
  }

  .arcade :global(.section-head::before) {
    display: none;
  }

  .arcade-title {
    display: flex;
    flex-direction: column;
  }

  /* The one sign on the site: stacked city-signage letters, lit in coral. */
  .arcade-sign {
    margin: 0 0 4px;
    font-family: var(--font-sign);
    font-size: clamp(44px, 6.4vw, 80px);
    line-height: 0.95;
    color: #ff3df0;
    letter-spacing: 0.02em;
    text-shadow:
      0 0 8px rgba(255, 61, 240, 0.8),
      0 0 26px rgba(255, 61, 240, 0.55);
  }

  .games {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(230px, 100%), 1fr));
    gap: 18px;
  }

  /* Each cabinet is trimmed in one of three neon colours, in turn. */
  .games li:nth-child(3n + 1) {
    --neon: #ff3df0;
  }

  .games li:nth-child(3n + 2) {
    --neon: #2de2ff;
  }

  .games li:nth-child(3n) {
    --neon: #ffe14d;
  }

  .game {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 10px 18px;
    border-radius: 14px;
    background: rgba(22, 12, 40, 0.92);
    color: #f4efff;
    text-decoration: none;
    box-shadow:
      inset 0 0 0 2px color-mix(in srgb, var(--neon) 70%, transparent),
      0 0 22px color-mix(in srgb, var(--neon) 22%, transparent);
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .game:hover {
    transform: translateY(-3px);
    color: #ffffff;
    box-shadow:
      inset 0 0 0 2px var(--neon),
      0 0 34px color-mix(in srgb, var(--neon) 45%, transparent);
  }

  /* A cabinet bezel around a curved CRT screen. The bezel is black in either light, like the real thing. */
  .cabinet {
    display: block;
    margin-bottom: 10px;
    padding: 8px;
    border-radius: 10px;
    background: #0b1416;
    box-shadow:
      inset 0 0 0 2px #26363c,
      inset 0 -5px 0 #04090a;
  }

  .screen {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 12px / 18px;
  }

  /* Screens run in attract mode: full colour, always on. */
  .screen :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
  }

  /* Scanlines and the dark corners of a tube. */
  .screen::after {
    content: '';
    position: absolute;
    z-index: 2;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0.24) 0 1px, transparent 1px 3px),
      radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.45) 100%);
  }

  .press {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 10%;
    translate: -50% 0;
    padding: 3px 8px;
    background: rgba(0, 0, 0, 0.6);
    color: #ffffff;
    font: 400 14px/1.2 var(--font-game);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
  }

  .game:hover .press,
  .game:focus-visible .press {
    opacity: 1;
    animation: press-blink 1s steps(1, end) infinite;
  }

  @keyframes press-blink {
    50% {
      opacity: 0;
    }
  }

  /* Titles stay in Figtree: in Pixelify, C reads as O and B as 8 ("Oar Racing", "8rick 8reaker"). */
  .game-title {
    padding-inline: 6px;
    font: 700 19px/1.25 var(--font-body);
    color: #ffffff;
  }

  .game-line {
    padding-inline: 6px;
    font-size: 16px;
    color: #cfc4ec;
  }

  /* Two to a row on phones, so the arcade doesn't become a very long hallway. */
  @media (max-width: 560px) {
    .games {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .game {
      padding: 6px 6px 12px;
    }

    .cabinet {
      padding: 5px;
      margin-bottom: 6px;
    }

    .game-title {
      font-size: 16px;
      line-height: 1.3;
    }

    .game-line {
      font-size: 14px;
      line-height: 1.4;
    }
  }
</style>
