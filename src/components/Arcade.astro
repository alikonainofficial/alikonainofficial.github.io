---
import { Image } from 'astro:assets';
import NewTabLink from './NewTabLink.astro';
import carracing from '../assets/arcade/carracing.png';
import warrior from '../assets/arcade/warriordungeon.png';
import brick from '../assets/arcade/brickbreaker.png';
import tennis from '../assets/arcade/tennis.png';
import simon from '../assets/arcade/simon.png';
import drumkit from '../assets/arcade/drumkit.png';
import dice from '../assets/arcade/dicegenerator.png';

const games = [
  { title: 'Car Racing', line: 'Race a friend, head to head.', href: 'https://alikonainofficial.github.io/Car_Racing/', img: carracing },
  { title: 'Warrior Legends', line: 'Grab the keys and clear the dungeon.', href: 'https://alikonainofficial.github.io/Warrior_Legends/', img: warrior },
  { title: 'Brick Breaker', line: 'The classic, no frills.', href: 'https://alikonainofficial.github.io/Brick_Breaker/', img: brick },
  { title: 'Tennis', line: 'A quick rally to clear your head.', href: 'https://alikonainofficial.github.io/Tennis_Game/', img: tennis },
  { title: 'Simon', line: 'How long can you hold the pattern?', href: 'https://alikonainofficial.github.io/simon_game/', img: simon },
  { title: 'Drum Kit', line: 'Play the drums with your keyboard.', href: 'https://alikonainofficial.github.io/drumkit/', img: drumkit },
  { title: 'Dice Roller', line: 'Settle an argument the fair way.', href: 'https://alikonainofficial.github.io/randomdicegenerator/', img: dice },
];
---

<section id="arcade" class="arcade" aria-labelledby="arcade-title" data-dwell="the arcade">
  <div class="wrap inner">
    <div class="section-head gel-cyan">
      <div class="arcade-title">
        <p class="arcade-sign" aria-hidden="true">Arcade</p>
        <h2 id="arcade-title" class="display">The back room arcade</h2>
      </div>
      <p>Where it started: small browser games I built in 2020 while learning JavaScript. They still run. Best on a laptop with a keyboard.</p>
    </div>
    <ul class="games">
      {
        games.map((g) => (
          <li>
            <NewTabLink class="game" href={g.href}>
              <span class="cabinet">
                <span class="screen">
                  <Image src={g.img} alt="" widths={[320, 480]} sizes="(min-width: 900px) 280px, 45vw" loading="lazy" />
                  <span class="press" aria-hidden="true">Press start</span>
                </span>
              </span>
              <span class="game-title">{g.title}</span>
              <span class="game-line">{g.line}</span>
            </NewTabLink>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .arcade {
    background: var(--bg-deep);
  }

  .inner {
    padding-block: 88px;
  }

  .arcade-title {
    display: flex;
    flex-direction: column;
  }

  /* The one sign on the site: stacked city-signage letters, lit in coral. */
  .arcade-sign {
    margin: 0 0 4px;
    font-family: var(--font-sign);
    font-size: clamp(44px, 6.4vw, 80px);
    line-height: 0.95;
    color: var(--marquee);
    letter-spacing: 0.02em;
  }

  .games {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(230px, 100%), 1fr));
    gap: 18px;
  }

  .game {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 10px 18px;
    border-radius: 14px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition:
      transform 200ms ease,
      background-color 200ms ease;
  }

  .game:hover {
    transform: translateY(-3px);
    background: var(--surface-2);
    color: var(--text);
  }

  /* A cabinet bezel around a curved CRT screen. The bezel is black in either light, like the real thing. */
  .cabinet {
    display: block;
    margin-bottom: 10px;
    padding: 8px;
    border-radius: 10px;
    background: #0b1416;
    box-shadow:
      inset 0 0 0 2px #26363c,
      inset 0 -5px 0 #04090a;
  }

  .screen {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 12px / 18px;
  }

  .screen :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    filter: grayscale(0.8) contrast(1.08) brightness(0.85);
    transition: filter 220ms ease;
  }

  /* At rest the screens glow in the room's teal; they switch to full colour when you reach for one. */
  .screen::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    background: #2f8f8a;
    mix-blend-mode: color;
    opacity: 0.8;
    transition: opacity 220ms ease;
  }

  /* Scanlines and the dark corners of a tube. */
  .screen::after {
    content: '';
    position: absolute;
    z-index: 2;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0.24) 0 1px, transparent 1px 3px),
      radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.45) 100%);
  }

  .press {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 10%;
    translate: -50% 0;
    padding: 3px 8px;
    background: rgba(0, 0, 0, 0.6);
    color: #ffffff;
    font: 400 14px/1.2 var(--font-game);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
  }

  .game:hover .screen :global(img),
  .game:focus-visible .screen :global(img) {
    filter: none;
  }

  .game:hover .screen::before,
  .game:focus-visible .screen::before {
    opacity: 0;
  }

  .game:hover .press,
  .game:focus-visible .press {
    opacity: 1;
    animation: press-blink 1s steps(1, end) infinite;
  }

  @keyframes press-blink {
    50% {
      opacity: 0;
    }
  }

  /* Titles stay in Figtree: in Pixelify, C reads as O and B as 8 ("Oar Racing", "8rick 8reaker"). */
  .game-title {
    padding-inline: 6px;
    font: 700 19px/1.25 var(--font-body);
    color: var(--text);
  }

  .game-line {
    padding-inline: 6px;
    font-size: 16px;
    color: var(--muted);
  }

  /* Two to a row on phones, so the arcade doesn't become a very long hallway. */
  @media (max-width: 560px) {
    .games {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .game {
      padding: 6px 6px 12px;
    }

    .cabinet {
      padding: 5px;
      margin-bottom: 6px;
    }

    .game-title {
      font-size: 16px;
      line-height: 1.3;
    }

    .game-line {
      font-size: 14px;
      line-height: 1.4;
    }
  }
</style>
