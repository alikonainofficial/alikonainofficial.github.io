---
interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<!--
  The jazz button. Three states, set from the page script:
  invite  — every visit starts here: the one filled brass pill in the header, breathing softly.
  playing — moving equalizer bars, and the label offers to pause.
  paused  — a quiet outline, so a visitor who said no isn't nagged.
-->
<button class:list={['sound-toggle', `sound-toggle--${tone}`]} type="button" data-sound-toggle data-state="invite" data-sfx="none">
  <svg class="icon icon-play" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
    <path d="M4 2.5v11a.6.6 0 0 0 .9.5l9-5.5a.6.6 0 0 0 0-1l-9-5.5a.6.6 0 0 0-.9.5z" fill="currentColor"></path>
  </svg>
  <svg class="icon icon-bars" width="18" height="16" viewBox="0 0 18 16" aria-hidden="true">
    <rect x="1" y="2" width="3" height="14" rx="1.5"></rect>
    <rect x="5.5" y="2" width="3" height="14" rx="1.5"></rect>
    <rect x="10" y="2" width="3" height="14" rx="1.5"></rect>
    <rect x="14.5" y="2" width="3" height="14" rx="1.5"></rect>
  </svg>
  <span class="sl-full" data-sound-label>Play the jazz</span>
  <span class="sl-short" aria-hidden="true">Jazz</span>
</button>

<script>
  import { setSound, soundState, type SoundState } from '../lib/audio';

  const LABEL: Record<SoundState, string> = { invite: 'Play the jazz', paused: 'Play the jazz', playing: 'Pause the jazz' };

  function sync() {
    const state = soundState();
    document.querySelectorAll<HTMLButtonElement>('[data-sound-toggle]').forEach((b) => {
      b.dataset.state = state;
      const label = b.querySelector('[data-sound-label]');
      if (label) label.textContent = LABEL[state];
    });
  }

  document.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('[data-sound-toggle]')) setSound(soundState() !== 'playing');
  });
  document.addEventListener('sound:change', sync);
  document.addEventListener('astro:page-load', sync);
</script>

<style>
  .sound-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1.5px solid var(--brass);
    background: transparent;
    color: var(--brass);
    font: 700 16px/1.2 var(--font-body);
    cursor: pointer;
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  .sound-toggle:hover {
    background: rgba(217, 179, 108, 0.12);
  }

  .icon {
    flex: 0 0 auto;
  }

  .icon-bars {
    display: none;
  }

  /* Invite: the only filled brass pill in the header, with a slow breath of light around it. */
  .sound-toggle--dark[data-state='invite'] {
    background: var(--brass);
    color: var(--bg);
    animation: invite-breathe 3.2s ease-out infinite;
  }

  .sound-toggle--dark[data-state='invite']:hover {
    background: var(--brass-hi);
  }

  @keyframes invite-breathe {
    0% {
      box-shadow: 0 0 0 0 rgba(217, 179, 108, 0.55);
    }
    60%,
    100% {
      box-shadow: 0 0 0 14px rgba(217, 179, 108, 0);
    }
  }

  /* Playing: the bars dance, and the button offers to pause. */
  .sound-toggle[data-state='playing'] {
    background: rgba(217, 179, 108, 0.14);
    color: var(--brass-hi);
  }

  [data-state='playing'] .icon-play {
    display: none;
  }

  [data-state='playing'] .icon-bars {
    display: block;
  }

  .icon-bars rect {
    fill: currentColor;
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: eq-bar 0.9s ease-in-out infinite alternate;
  }

  .icon-bars rect:nth-child(1) {
    animation-duration: 0.8s;
  }

  .icon-bars rect:nth-child(2) {
    animation-duration: 1.1s;
    animation-delay: -0.4s;
  }

  .icon-bars rect:nth-child(3) {
    animation-duration: 0.7s;
    animation-delay: -0.2s;
  }

  .icon-bars rect:nth-child(4) {
    animation-duration: 1s;
    animation-delay: -0.6s;
  }

  @keyframes eq-bar {
    from {
      transform: scaleY(0.3);
    }
    to {
      transform: scaleY(1);
    }
  }

  /* Without motion: a steady ring for the invite, and still bars of different heights. */
  @media (prefers-reduced-motion: reduce) {
    .sound-toggle--dark[data-state='invite'] {
      box-shadow: 0 0 0 4px rgba(217, 179, 108, 0.3);
    }

    .icon-bars rect:nth-child(odd) {
      transform: scaleY(0.55);
    }
  }

  .sl-short {
    display: none;
  }

  /* Phones get a shorter label; screen readers still hear the full one. */
  @media (max-width: 720px) {
    .sound-toggle {
      gap: 8px;
      padding: 6px 14px;
      font-size: 15px;
    }

    .sl-full {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .sl-short {
      display: inline;
    }
  }

  /* The plain résumé: the same control, in ink, and it never pleads. */
  .sound-toggle--light {
    border-color: #1f3a33;
    color: #1f3a33;
  }

  .sound-toggle--light:hover {
    background: rgba(31, 58, 51, 0.08);
  }

  .sound-toggle--light[data-state='playing'] {
    background: #1f3a33;
    color: #ffffff;
  }
</style>
