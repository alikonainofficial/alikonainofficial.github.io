---
/**
 * Player One's shelf: the top five games as a console home screen. The chosen
 * game's art fills the section; a row of tiles picks another (hover, tap, focus
 * or the arrow keys). It stays a dark screen in either house light, like the
 * arcade's cabinets. Without script it simply shows #1.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { games } from '../lib/favourites';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/favourites/*.{jpg,jpeg,png,webp}', { eager: true });
const imageFor = (slug: string) => Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === slug)?.[1].default;
const first = games[0]!;
---

<section id="player-one" class="player-one" data-seam="halftone" aria-labelledby="player-one-title" data-dwell="player one's shelf" style={`--accent:${first.accent}`} data-console>
  <div class="art-stack" aria-hidden="true">
    {
      games.map((g, i) => {
        const img = imageFor(g.slug);
        return (
          <div class="art" data-art={i} data-on={i === 0 ? '' : undefined}>
            {img && (
              <Picture
                src={img}
                alt=""
                formats={['avif', 'webp']}
                widths={[800, 1280, 1600]}
                sizes="100vw"
                loading="lazy"
                style={g.focus ? `object-position:${g.focus}` : undefined}
              />
            )}
          </div>
        );
      })
    }
    <div class="shade"></div>
  </div>

  <div class="wrap screen">
    <div class="status" aria-hidden="true">
      <span class="player"><span class="dot"></span> Player 1</span>
      <span data-clock></span>
    </div>

    <div class="intro" data-rise>
      <p class="kicker">Top five, in order</p>
      <h2 id="player-one-title" class="display">Player One's shelf</h2>
      <p class="lede">The ones I'd take to a desert island, if it had a socket. Pick one.</p>
    </div>

    <div class="now" aria-live="polite" data-rise>
      <p class="rank" data-rank>No. 1 of 5</p>
      <p class="title" data-title>{first.title}</p>
    </div>

    <ol class="tiles" data-rise aria-label="My top five games, in order">
      {
        games.map((g, i) => {
          const img = imageFor(g.slug);
          return (
            <li>
              <button
                type="button"
                class="tile"
                data-tile={i}
                data-title={g.title}
                data-accent={g.accent}
                aria-pressed={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-sfx="none"
              >
                {img && <Picture src={img} alt="" formats={['avif', 'webp']} widths={[160, 280]} sizes="140px" loading="lazy" style={`object-position:${g.tile}`} />}
                <span class="visually-hidden">
                  {i + 1}. {g.title}
                </span>
              </button>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<script>
  import { sfx } from '../lib/audio';

  function setup() {
    const root = document.querySelector<HTMLElement>('[data-console]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const tiles = [...root.querySelectorAll<HTMLButtonElement>('[data-tile]')];
    const arts = [...root.querySelectorAll<HTMLElement>('[data-art]')];
    const title = root.querySelector<HTMLElement>('[data-title]')!;
    const rank = root.querySelector<HTMLElement>('[data-rank]')!;
    let current = 0;

    const select = (i: number, sound = true) => {
      if (i === current) return;
      current = i;
      const t = tiles[i]!;
      tiles.forEach((b, j) => {
        b.setAttribute('aria-pressed', String(j === i));
        b.tabIndex = j === i ? 0 : -1;
      });
      arts.forEach((a, j) => (j === i ? a.setAttribute('data-on', '') : a.removeAttribute('data-on')));
      root.style.setProperty('--accent', t.dataset.accent!);
      title.textContent = t.dataset.title!;
      rank.textContent = `No. ${i + 1} of ${tiles.length}`;
      if (sound) sfx('tick');
    };

    tiles.forEach((b, i) => {
      b.addEventListener('click', () => select(i));
      b.addEventListener('focus', () => select(i, false));
      b.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') select(i);
      });
      // A console's d-pad: left and right move along the row.
      b.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        const to = e.key === 'Home' ? 0 : e.key === 'End' ? tiles.length - 1 : (i + step + tiles.length) % tiles.length;
        if (!step && e.key !== 'Home' && e.key !== 'End') return;
        e.preventDefault();
        tiles[to]!.focus();
      });
    });

    // The status bar's clock reads the visitor's own time, like a console's home screen.
    const clock = root.querySelector<HTMLElement>('[data-clock]')!;
    const tick = () => (clock.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }));
    tick();
    setInterval(tick, 20_000);
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .player-one {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    min-height: calc(clamp(600px, 92svh, 820px) + var(--seam));
    background: #05070a;
    color: #ffffff;
  }

  .art-stack,
  .art,
  .shade {
    position: absolute;
    inset: 0;
  }

  .art-stack {
    z-index: -1;
  }

  /* The chosen game's art cross-fades in. */
  .art {
    opacity: 0;
    transition: opacity 650ms ease;
  }

  .art[data-on] {
    opacity: 1;
  }

  .art :global(picture),
  .art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .art :global(img) {
    object-fit: cover;
  }

  /* Darken the bottom and left for the text, and tint the top with the game's colour. */
  .shade {
    background:
      linear-gradient(to top, rgba(4, 6, 9, 0.97) 0%, rgba(4, 6, 9, 0.78) 30%, rgba(4, 6, 9, 0.12) 62%, rgba(4, 6, 9, 0.6) 100%),
      linear-gradient(to right, rgba(4, 6, 9, 0.7), transparent 60%),
      radial-gradient(ellipse 60% 40% at 80% 0%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%);
    transition: background 650ms ease;
  }

  .screen {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding-block: 72px 136px;
  }

  .status {
    display: flex;
    justify-content: space-between;
    font: 400 15px/1 var(--font-game);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  .player {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  .intro {
    margin-top: 40px;
    max-width: 34rem;
  }

  .kicker {
    margin: 0 0 8px;
    font: 700 12px/1.3 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    transition: color 650ms ease;
  }

  .intro h2 {
    margin: 0;
    font-size: clamp(40px, 5vw, 60px);
    color: #ffffff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.6);
  }

  .lede {
    margin: 10px 0 0;
    color: rgba(255, 255, 255, 0.82);
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.8);
  }

  .now {
    margin-top: auto;
    padding-top: 48px;
  }

  .rank {
    margin: 0 0 4px;
    font: 400 16px/1 var(--font-game);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    transition: color 650ms ease;
  }

  .title {
    margin: 0;
    font: 800 clamp(36px, 5.4vw, 68px) / 1.05 var(--font-body);
    letter-spacing: -0.02em;
    text-shadow: 0 3px 30px rgba(0, 0, 0, 0.7);
  }

  /* The row of game tiles. The chosen one grows and lights up in its game's colour. */
  .tiles {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    display: block;
    width: 96px;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 14px;
    overflow: hidden;
    background: #111;
    cursor: pointer;
    opacity: 0.72;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.55);
    transition:
      width 260ms ease,
      opacity 260ms ease,
      box-shadow 260ms ease;
  }

  .tile :global(picture),
  .tile :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tile :global(img) {
    object-fit: cover;
  }

  .tile:hover {
    opacity: 1;
  }

  .tile[aria-pressed='true'] {
    width: 132px;
    opacity: 1;
    box-shadow:
      0 0 0 3px #ffffff,
      0 0 30px color-mix(in srgb, var(--accent) 70%, transparent),
      0 12px 28px rgba(0, 0, 0, 0.6);
  }

  .tile:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 5px;
  }

  @media (max-width: 720px) {
    .player-one {
      min-height: calc(640px + var(--seam));
    }

    .intro {
      margin-top: 28px;
    }

    /* Five tiles share the width, so the whole shelf fits without scrolling. */
    .tiles {
      gap: 8px;
    }

    .tiles li {
      flex: 1 1 0;
      min-width: 0;
    }

    .tile,
    .tile[aria-pressed='true'] {
      width: 100%;
      border-radius: 10px;
    }

    .tile[aria-pressed='true'] {
      box-shadow:
        0 0 0 2px #ffffff,
        0 0 20px color-mix(in srgb, var(--accent) 70%, transparent);
    }
  }
</style>
