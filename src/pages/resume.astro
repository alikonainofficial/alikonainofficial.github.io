---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { acts, education, person, skills, summary } from '../lib/profile';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Résumé"
  description={`${person.name}'s résumé on one page: ${person.title.toLowerCase()}, experience, skills and education.`}
  bodyClass="plain"
>
  <div class="toolbar no-print">
    <a href="/">Back to the show</a>
    <button type="button" data-print>Print or save as PDF</button>
  </div>

  <main id="main" class="sheet">
    <header class="sheet-head">
      <h1>{person.fullName}</h1>
      <p class="role">{person.title}, {person.location}</p>
      <ul class="contact">
        <li><a href={`mailto:${person.email}`}>{person.email}</a></li>
        <li><a href={person.linkedin}>linkedin.com/in/ali-konain</a></li>
        <li><a href={person.github}>github.com/alikonainofficial</a></li>
        <li><a href="https://alikonainofficial.github.io/">alikonainofficial.github.io</a></li>
      </ul>
    </header>

    <section aria-labelledby="r-summary">
      <h2 id="r-summary">Summary</h2>
      <p>{summary}</p>
    </section>

    <section aria-labelledby="r-skills">
      <h2 id="r-skills">Skills</h2>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="r-exp">
      <h2 id="r-exp">Experience</h2>
      {
        acts.map((a) => (
          <article class="job">
            <div class="job-head">
              <h3>
                {a.role}, {a.company}
              </h3>
              <p class="dates">
                {a.start} to {a.end === 'now' ? 'present' : a.end}
              </p>
            </div>
            <ul>
              {a.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section aria-labelledby="r-work">
      <h2 id="r-work">Selected work</h2>
      <ul class="work">
        {
          work.map((w) => (
            <li>
              <a href={`/work/${w.id}/`}>{w.data.title}</a>: {w.data.summary}
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="r-edu">
      <h2 id="r-edu">Education</h2>
      {
        education.map((e) => (
          <div class="job-head">
            <h3>
              {e.degree}, {e.school}
            </h3>
            <p class="dates">{e.period}</p>
          </div>
        ))
      }
    </section>
  </main>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style is:global>
  body.plain {
    background: #f4f1ea;
    color: #1d1a1b;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color-scheme: light;
  }

  body.plain a {
    color: #6a1a2c;
  }

  body.plain :focus-visible {
    outline-color: #6a1a2c;
  }
</style>

<style>
  .toolbar {
    max-width: 860px;
    margin: 0 auto;
    padding: 16px 24px 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .toolbar a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .toolbar button {
    min-height: 44px;
    padding: 8px 16px;
    border: 2px solid #1d1a1b;
    background: transparent;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .toolbar button:hover {
    background: #1d1a1b;
    color: #f4f1ea;
  }

  .sheet {
    max-width: 860px;
    margin: 16px auto 64px;
    padding: 48px clamp(20px, 5vw, 56px);
    background: #fff;
    box-shadow: 0 1px 0 #e3ddd0, 0 0 0 1px #e3ddd0;
  }

  .sheet-head {
    border-bottom: 2px solid #1d1a1b;
    padding-bottom: 16px;
  }

  h1 {
    margin: 0;
    font-size: 32px;
    letter-spacing: -0.01em;
  }

  .role {
    margin: 4px 0 10px;
    font-size: 18px;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  section {
    margin-top: 28px;
  }

  h2 {
    margin: 0 0 10px;
    font-size: 17px;
    color: #6a1a2c;
  }

  h3 {
    margin: 0;
    font-size: 16px;
  }

  .skills {
    margin: 0;
    display: grid;
    gap: 6px;
  }

  .skills div {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 12px;
  }

  .skills dt {
    font-weight: 600;
  }

  .skills dd {
    margin: 0;
  }

  .job + .job {
    margin-top: 18px;
  }

  .job-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 2px 16px;
  }

  .job-head + .job-head {
    margin-top: 8px;
  }

  .dates {
    margin: 0;
    font-size: 15px;
    color: #5b4636;
  }

  ul {
    margin: 6px 0 0;
    padding-left: 20px;
  }

  li + li {
    margin-top: 4px;
  }

  @media (max-width: 600px) {
    .skills div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }

  @media print {
    .no-print {
      display: none;
    }

    .sheet {
      margin: 0;
      padding: 0;
      box-shadow: none;
      max-width: none;
    }

    a {
      color: inherit;
      text-decoration: none;
    }
  }
</style>
