---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/figtree/wght.css';
import '@fontsource-variable/pixelify-sans/wght.css';
import '@fontsource/silkscreen/latin-400.css';
import '@fontsource/silkscreen/latin-700.css';
import '@fontsource/bungee-shade/latin-400.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ProgramWidget from '../components/ProgramWidget.astro';
import SiteScripts from '../components/SiteScripts.astro';
import { person } from '../lib/profile';

interface Props {
  title?: string;
  description?: string;
  /** Pages like the printable résumé bring their own look. */
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title,
  description = `${person.name}, ${person.title.toLowerCase()} in ${person.location}. Ships AI that holds up in production and automates the tedious parts at scale.`,
  bodyClass,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${person.name}` : `${person.name}, ${person.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<!-- The curtain does the page change, so the default cross-fade would only blur it. -->
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0e2427" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- House lights: set before the first paint so a visitor who chose daylight never sees a flash of night. -->
    <script is:inline>
      (() => {
        const apply = (doc) => {
          let up = false;
          try {
            up = localStorage.getItem('house-lights') === 'up';
          } catch {}
          if (up) doc.documentElement.dataset.lights = 'up';
          else delete doc.documentElement.dataset.lights;
          doc.querySelector('meta[name="theme-color"]')?.setAttribute('content', up ? '#f6f1e7' : '#0e2427');
        };
        apply(document);
        document.addEventListener('astro:before-swap', (e) => apply(e.newDocument));
      })();
    </script>

    <ClientRouter />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <ProgramWidget />
    <div class="curtain" aria-hidden="true" transition:persist="curtain" data-curtain><span></span><span></span></div>
    <SiteScripts />
  </body>
</html>
